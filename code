# Question 4
# A program that converts degrees celsius to the kelvin temperature scale

def main():
    celsius = float(input("What is the Celsius temperature? "))
    kelvin = celsius + 273.15
    print("The temperature is", kelvin, "degrees kelvin.")

# Question 5
# A program that degrees fahrenheit to the kelvin temperature scale

def main():
    fahrenheit = float(input("What is the temperature in fahrenheit? "))
    kelvin = (fahrenheit - 32) * 5/9 + 273.15
    print("The temperature is", kelvin, "degrees kelvin.")
